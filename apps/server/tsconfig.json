{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "../../",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "incremental": true,
    "types": ["node", "multer"]
  },
  "include": ["src/**/*.ts", "../../libs/shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
