# Copie ce fichier en `.env` (gitignoré) puis remplis les valeurs.
# `npm run start:prod` et le LaunchDaemon le lisent via `node --env-file`.

# Port d'écoute HTTP/WS.
PORT=3000

# Interface d'écoute. En NODE_ENV=production le défaut est déjà 127.0.0.1
# (bind local uniquement : tout transite par le tunnel sortant cloudflared,
# aucun port entrant — PRD §7.2). Ne mets 0.0.0.0 que dans un conteneur.
HOST=127.0.0.1

# Comportements de production : bind local par défaut, seed RNG de test
# refusée, garde-fou sur le mot de passe admin.
NODE_ENV=production

# Mot de passe de la page /admin — OBLIGATOIRE en production : le serveur
# refuse de démarrer s'il vaut « change-me » (défaut) ou s'il est vide.
ADMIN_PASSWORD=
